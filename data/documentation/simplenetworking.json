{"metadata":{"title":"SimpleNetworking","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"SimpleNetworking"}],"role":"collection","externalID":"SimpleNetworking"},"kind":"symbol","hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"SimpleNetworking is a Foundation-based HTTP client for applications and services that need a small, explicit networking layer. It provides traditional GET, POST, PUT, PATCH, and DELETE requests; multipart uploads; file downloads; cookies; response decoding; mocks; Server-Sent Events; and WebSockets."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The library is designed around "},{"type":"codeVoice","code":"async"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"await"},{"type":"text","text":". The closure-based request and upload APIs remain available for existing code, but are deprecated in favor of structured concurrency."}],"type":"paragraph"},{"anchor":"Create-a-client","text":"Create a client","type":"heading","level":3},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/shared","isActive":true,"type":"reference"},{"text":" for simple or legacy call sites:","type":"text"}],"type":"paragraph"},{"code":["let networking = SimpleNetworking.shared","networking.set(serverURL: \"https:\/\/api.example.com\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"For new code, prefer an isolated client configured once at creation time. "},{"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/Configuration","type":"reference","isActive":true},{"text":" is immutable, and the client takes an atomic settings snapshot before each request.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Clients use ","type":"text"},{"type":"codeVoice","code":"URLSession\/shared"},{"text":" by default. Set ","type":"text"},{"type":"codeVoice","code":"sessionMode"},{"text":" to ","type":"text"},{"type":"codeVoice","code":".ephemeral"},{"text":" to use isolated in-memory cookie and cache storage, or pass a custom session to the initializer when you need a specific URL session configuration.","type":"text"}]},{"code":["let networking = SimpleNetworking(configuration: .init(","    serverURL: \"https:\/\/api.example.com\",","    authorization: \"access-token\",","    headers: [.init(name: \"X-App-Version\", value: \"1.0\")],","    sessionMode: .ephemeral","))"],"syntax":"swift","type":"codeListing"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"An authorization value is sent as a Bearer token. Supply the token only, without the ","type":"text"},{"code":"Bearer ","type":"codeVoice"},{"text":" prefix.","type":"text"}]}],"type":"aside","style":"important"},{"text":"Making requests","level":2,"anchor":"Making-requests","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/request(path:method:encoding:file:line:function:)"},{"type":"text","text":" for concise calls. Paths beginning with "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" are resolved against the configured server URL; absolute URLs can be used directly."}]},{"code":["let response = await networking.request(path: \"\/users\", method: .get)","","guard response.isSuccess else {","    print(response.networkingError?.localizedDescription ?? \"Request failed\")","    return","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Request bodies are encoded according to "},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/POSTEncoding","isActive":true},{"type":"text","text":". JSON is the default. A "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" value is used as-is; dictionaries and "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" values can be encoded as JSON; "},{"type":"codeVoice","code":".plain"},{"type":"text","text":" uses form encoding; and "},{"type":"codeVoice","code":".graphQL"},{"type":"text","text":" wraps a query string in a JSON object."}]},{"code":["let response = await networking.request(","    path: \"\/users\",","    method: .post([\"display_name\": \"Taylor\"])",")"],"syntax":"swift","type":"codeListing"},{"text":"Per-request settings","anchor":"Per-request-settings","level":3,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/Request"},{"text":" when one call needs query items, headers, a timeout, cache behavior, or a custom HTTP method. Per-request headers replace matching headers from the client configuration, without changing that configuration.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let request = SimpleNetworking.Request(","    path: \"\/users\",","    method: .get,","    query: [\"page\": \"2\"],","    headers: [.init(name: \"X-Request-ID\", value: UUID().uuidString)],","    timeout: 15,","    cachePolicy: .reloadIgnoringLocalCacheData",")","","let response = await networking.execute(request)"],"type":"codeListing"},{"inlineContent":[{"text":"For methods not represented by ","type":"text"},{"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/HTTPMethod","isActive":true,"type":"reference"},{"text":", pass an uppercase method name and a raw body.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let request = SimpleNetworking.Request(","    path: \"\/documents\",","    method: \"PROPFIND\",","    body: Data()",")","let response = await networking.execute(request)"],"type":"codeListing"},{"text":"Handling responses and errors","anchor":"Handling-responses-and-errors","level":2,"type":"heading"},{"inlineContent":[{"text":"Every operation returns ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/NetworkResponse","isActive":true},{"text":". It preserves the original ","type":"text"},{"type":"codeVoice","code":"URLRequest"},{"text":", the ","type":"text"},{"type":"codeVoice","code":"URLResponse"},{"text":", status code, response headers, data, text representation, parsed JSON dictionary when possible, and received cookies.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/NetworkResponse\/isSuccess","isActive":true},{"type":"text","text":" is true only for a 2xx status without a transport error. Non-2xx results are represented by "},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/NetworkingError","isActive":true},{"type":"text","text":" with a status code, headers, and an error-body snippet (limited to 4 KB)."}],"type":"paragraph"},{"syntax":"swift","code":["let response = await networking.request(path: \"\/profile\", method: .get)","","if let error = response.networkingError {","    print(error.kind)            \/\/ for example, .httpStatus","    print(error.statusCode ?? 0)","    print(error.bodySnippet ?? \"\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Decode a successful response with the throwing "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/NetworkResponse\/decode(_:strategy:)"},{"type":"text","text":" API. The older "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/NetworkResponse\/decoded(strategy:file:line:function:)"},{"type":"text","text":" convenience returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on failure and logs diagnostic information."}],"type":"paragraph"},{"syntax":"swift","code":["struct User: Decodable {","    let id: String","    let displayName: String","}","","do {","    let response = await networking.request(path: \"\/me\", method: .get)","    let user: User = try response.decode(strategy: .convertFromSnakeCase)","    print(user.displayName)","} catch let error as SimpleNetworking.NetworkingError {","    print(error.localizedDescription)","}"],"type":"codeListing"},{"text":"Uploading and downloading files","anchor":"Uploading-and-downloading-files","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/upload(path:uploadData:file:line:function:)","isActive":true},{"type":"text","text":" with "},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/MultipartUploadData","isActive":true},{"type":"text","text":" for small in-memory uploads."}]},{"type":"codeListing","syntax":"swift","code":["let file = SimpleNetworking.FileUpload(","    data: Data(\"Hello\".utf8),","    name: \"document\",","    filename: \"hello.txt\",","    mimeType: \"text\/plain\"",")","let upload = SimpleNetworking.MultipartUploadData(file: file)","let response = await networking.upload(path: \"\/upload\", uploadData: upload)"]},{"type":"paragraph","inlineContent":[{"text":"For large files, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/FileBackedMultipartUploadData","type":"reference"},{"text":". The source is copied in 64 KB chunks to a temporary multipart file, and the upload task reads that file directly rather than retaining the file content in the request body.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let file = try SimpleNetworking.FileBackedMultipartUploadData.File(","    fileURL: videoURL,","    name: \"video\"",")","let upload = SimpleNetworking.FileBackedMultipartUploadData(file: file)","","let response = await networking.upload(path: \"\/upload\", fileUploadData: upload) { progress in","    print(progress.fractionCompleted ?? 0)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Download a resource directly to disk with "},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/download(path:to:onProgress:)","isActive":true},{"type":"text","text":". It does not retain the downloaded body in the returned response."}]},{"type":"codeListing","syntax":"swift","code":["let response = await networking.download(path: \"\/archive.zip\", to: destinationURL) { progress in","    print(progress.completedUnitCount)","}"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/Transfer"},{"text":" when progress should be consumed as an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let transfer = networking.uploadTransfer(path: \"\/upload\", uploadData: upload)","for await progress in transfer.progress {","    print(progress.fractionCompleted ?? 0)","}","let response = await transfer.response.value"]},{"type":"heading","text":"Cookies and testing","anchor":"Cookies-and-testing","level":2},{"type":"paragraph","inlineContent":[{"text":"The client keeps its own cookie collection. Add a cookie with ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/add(cookie:)","isActive":true},{"text":" or ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/cookie(domain:path:name:value:)","isActive":true},{"text":"; cookies received in an HTTP response are saved automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/set(mockData:)","type":"reference","isActive":true},{"type":"text","text":" to provide deterministic responses in tests. Mock keys are absolute URLs."}]},{"type":"codeListing","syntax":"swift","code":["networking.set(mockData: [","    \"https:\/\/api.example.com\/health\": .init(","        data: \"{\\\"ok\\\":true}\",","        response: nil,","        statusCode: 200,","        error: nil","    )","])"]},{"level":2,"type":"heading","anchor":"Realtime-connections","text":"Realtime connections"},{"inlineContent":[{"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/eventSource(path:onOpen:onMessage:onError:)","type":"reference","isActive":true},{"type":"text","text":" opens a Server-Sent Events connection and forwards received data chunks. Call "},{"identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/eventSourceDisconnect()","type":"reference","isActive":true},{"type":"text","text":" when it is no longer needed."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SimpleNetworking\/documentation\/SimpleNetworking\/SimpleNetworking\/connect(to:responder:)"},{"type":"text","text":" establishes a WebSocket connection. Use "},{"type":"codeVoice","code":"SimpleNetworking\/send(message:)"},{"type":"text","text":" to send "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Data"},{"type":"text","text"